# GitHub Secrets / Environment Variables
# Copy to .env for local testing (never commit .env!)

# Required: Gemini API key or OpenAI key
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-001

# Required: GitHub Personal Access Token (classic with repo scope or fine-grained)
# In GitHub Actions, secrets.GITHUB_TOKEN is provided automatically.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Repository name for local debugging (format: owner/repo)
REPO_FULL_NAME=your-username/your-repo

# Optional: Specific issue or PR number for manual script invocation
# ISSUE_NUMBER=1
# PR_NUMBER=1
# FAILED_RUN_ID=12345678
